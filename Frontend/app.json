{
  "expo": {
    "name": "BeSide",
    "slug": "BeSide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/BeSide.png",

    "scheme": "myapp",
    "deepLinks": ["myapp://"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,

    "splash": {
      "image": "./assets/images/BeSide.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.BeSide",
      "config": {
        "googleMapsApiKey": "AIzaSyDFwWtCQPY8KaiHVahvSr5jldGGFzbMDVw"
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/BeSide.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.BeSide",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDFwWtCQPY8KaiHVahvSr5jldGGFzbMDVw"
        }
      }
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/BeSide.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/BeSide.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}
